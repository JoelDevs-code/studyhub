      "id": "faq-001",
      "question": "What is StudyHub?",
      "answer": "StudyHub is a student-focused platform for finding course materials, past questions, video tutorials, projects, and source code."
    },
    {
      "id": "faq-002",
      "question": "How do I download a resource?",
      "answer": "Open a resource and select its download option. In this demo dataset, download links are placeholders until you add the actual files."
    },
    {
      "id": "faq-003",
      "question": "Can I use StudyHub on my phone?",
      "answer": "Yes. The interface is intended to be responsive across desktop, tablet, and mobile devices."
    },
    {
      "id": "faq-004",
      "question": "Can I upload my own materials?",
      "answer": "Uploading resources for all users requires a backend or file-storage service. The current frontend-only demo displays sample resources."
    }
